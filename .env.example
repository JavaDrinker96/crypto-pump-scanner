# ========================
# PUMP SCANNER CONFIG
# ========================

PUMP_MODE=trading
TRADING_ENABLED=false
BYBIT_TESTNET=false

# API КЛЮЧИ (ЗАМЕНИ НА СВОИ!)
BYBIT_API_KEY=your_key_here
BYBIT_API_SECRET=your_secret_here

# TELEGRAM (ЗАМЕНИ НА СВОИ!)
TELEGRAM_TOKEN=your_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ========================
# SCANNING PARAMETERS
# ========================
PUMP_SCAN_INTERVAL=10
PUMP_VOL_SPIKE_MULT=5.0
PUMP_PRICE_SPIKE_PCT=0.03
PUMP_DUMP_PRICE_SPIKE_PCT=0.03
PUMP_PRICE_WINDOW=5
PUMP_MIN_DOLLAR_VOL=500000

PUMP_CONFIRM_CANDLES=3
PUMP_MIN_RSI_ENTRY=60
PUMP_MAX_RSI_ENTRY=85
PUMP_MIN_BUY_RATIO=0.65

PUMP_DUMP_MAX_RSI=45
PUMP_DUMP_MIN_SELL_RATIO=0.65

# ========================
# TRADING - LEVERAGE & SIZE
# ========================

PUMP_LEVERAGE=2
PUMP_RISK_BUDGET_PCT=0.20
PUMP_MAX_POSITIONS=2
MIN_NOTIONAL=2
PUMP_COOLDOWN_SEC=300

# ========================
# TP/SL - PERCENTAGE BASED (%)
# ========================

# ===== LONG (PUMP) =====
# Stop Loss - выставляется НИЖЕ входа
PUMP_SL_PCT=0.015

# Take Profit уровни - ВЫШЕ входа
PUMP_TP1_PCT=0.03         # +3%
PUMP_TP2_PCT=0.05         # +5%
PUMP_TP3_PCT=0.08         # +8%

# Процент позиции для закрытия на каждом TP
PUMP_TP1_CLOSE_PCT=0.50   # Закрыть 50% на TP1
PUMP_TP2_CLOSE_PCT=0.30   # Закрыть 30% на TP2
PUMP_TP3_CLOSE_PCT=0.20   # Закрыть 20% на TP3

# Trailing stop после TP2
PUMP_TRAILING_PCT=0.02

# ===== SHORT (DUMP) =====
# Stop Loss - выставляется ВЫШЕ входа (обратное для short)
SHORT_SL_PCT=0.015

# Take Profit уровни - НИЖЕ входа (прибыль идет вниз)
SHORT_TP1_PCT=0.03        # -3%
SHORT_TP2_PCT=0.05        # -5%
SHORT_TP3_PCT=0.08        # -8%

# Процент позиции для закрытия на каждом TP
SHORT_TP1_CLOSE_PCT=0.50  # Закрыть 50% на TP1
SHORT_TP2_CLOSE_PCT=0.30  # Закрыть 30% на TP2
SHORT_TP3_CLOSE_PCT=0.20  # Закрыть 20% на TP3

# Trailing stop после TP2
SHORT_TRAILING_PCT=0.02

# ========================
# LISTINGS
# ========================
PUMP_LISTING_CHECK=60

# ========================
# TEST
# ========================
PUMP_TEST_ALERT=true
