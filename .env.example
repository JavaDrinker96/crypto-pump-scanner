# ========================
# PUMP SCANNER CONFIG
# ========================

PUMP_MODE=trading
TRADING_ENABLED=true
BYBIT_TESTNET=false

# API КЛЮЧИ (замени на свои!)
BYBIT_API_KEY=your_key
BYBIT_API_SECRET=your_secret

# TELEGRAM (замени на свои!)
TELEGRAM_TOKEN=your_token
TELEGRAM_CHAT_ID=your_chat_id

# ========================
# SCANNING PARAMETERS
# ========================
PUMP_SCAN_INTERVAL=10
PUMP_VOL_SPIKE_MULT=5.0
PUMP_PRICE_SPIKE_PCT=0.03
PUMP_DUMP_PRICE_SPIKE_PCT=0.03
PUMP_PRICE_WINDOW=5
PUMP_MIN_DOLLAR_VOL=500000

# Pump filters
PUMP_CONFIRM_CANDLES=3
PUMP_MIN_RSI_ENTRY=60
PUMP_MAX_RSI_ENTRY=85
PUMP_MIN_BUY_RATIO=0.65

# Dump filters
PUMP_DUMP_MAX_RSI=45
PUMP_DUMP_MIN_SELL_RATIO=0.65

# ========================
# TRADING (ОПТИМИЗИРОВАНО)
# ========================

# Leverage (для $40 депозита)
PUMP_LEVERAGE=2

# Position size (20% риска)
PUMP_RISK_BUDGET_PCT=0.20

# Maximum concurrent positions
PUMP_MAX_POSITIONS=3

# Take Profit Levels (LONG)
PUMP_TP1_PCT=0.03
PUMP_TP2_PCT=0.05
PUMP_TP3_PCT=0.08

# Stop Loss & Trailing
PUMP_SL_ATR_MULT=1.2
PUMP_TRAILING_PCT=0.02

# SHORT (DUMP) specific
SHORT_SL_ATR_MULT=1.5
SHORT_TP_PCT=0.03

# Minimum notional
MIN_NOTIONAL=2

# Cooldown between trades
PUMP_COOLDOWN_SEC=300

# ========================
# LISTINGS
# ========================
PUMP_LISTING_CHECK=60

# ========================
# TEST
# ========================
PUMP_TEST_ALERT=true
